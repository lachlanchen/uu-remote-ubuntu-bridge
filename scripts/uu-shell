#!/usr/bin/env bash
# Open a peer shell through its explicitly configured transport.
# No desktop connection, mapping recovery, transport fallback or retry.
set -Eeuo pipefail

helper="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/uu-ssh"
if [[ $# == 0 || ${1:-} == -h || ${1:-} == --help ]]; then
    printf '%s\n' \
        'Usage: uu-shell PEER [transport arguments...]' \
        '       uu-shell --lazy PEER [SSH arguments...]' \
        '       uu-shell --native PEER [UU terminal options...]' \
        '       uu-shell --list' \
        '       uu-shell --check PEER' \
        'Example: uu-shell lab' \
        'Uses the transport explicitly selected by uu-ssh add.' \
        'Native UU Terminal requests a fresh session by default.' \
        'SSH profiles accept normal ssh arguments and remote commands.' \
        'Never issues device connect, accepts takeover or performs recovery.' \
        'Use --session-id ID to explicitly attach, or --list-sessions to inspect.' \
        'Even a session-list query may initialize UU transport.' \
        'A working UU Terminal channel and the peer terminal patch are required.' \
        'No cloud fallback, auto-retry or connection-availability guarantee.'
    exit 0
fi
case "$1" in
    --lazy) shift; exec "$helper" fleet-shell "$@" ;;
    --native) shift; exec "$helper" native-shell "$@" ;;
    --list) shift; exec "$helper" list "$@" ;;
    --check) shift; exec "$helper" check "$@" ;;
esac
exec "$helper" shell "$@"
