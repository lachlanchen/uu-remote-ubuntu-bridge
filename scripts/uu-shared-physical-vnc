#!/usr/bin/python3
"""Share an existing GDM X11 desktop; never create or log out a session.

Opt-in user service for a PAM-authenticated XRDP VNC proxy and UU Remote.
This loopback-only backend has no VNC password: network-facing consumers
must authenticate users before forwarding them here.
"""
import os
from pathlib import Path
import subprocess

uid = os.getuid()
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{uid}'))
authority = runtime / 'gdm/Xauthority'
port = int(os.environ.get('UURB_SHARED_VNC_PORT', '5922'))
if not 5900 <= port <= 5999:
    raise SystemExit('Shared VNC port must be in 5900..5999')
if not authority.is_file():
    raise SystemExit('Waiting for this user to log in to the GDM X11 desktop')

display = None
for proc in Path('/proc').iterdir():
    if not proc.name.isdigit():
        continue
    try:
        if proc.stat().st_uid != uid or (proc / 'comm').read_text().strip() != 'gnome-shell':
            continue
        env = dict(item.split('=', 1) for item in
                   (proc / 'environ').read_bytes().decode(errors='replace').split('\0')
                   if '=' in item)
        if env.get('XDG_SESSION_TYPE') == 'x11' and env.get('XAUTHORITY') == str(authority):
            display = env.get('DISPLAY')
            break
    except (OSError, ValueError):
        continue
if not display:
    raise SystemExit('No logged-in physical GDM X11 desktop found; no virtual fallback')
subprocess.run(['/usr/bin/xdpyinfo', '-display', display],
               env={**os.environ, 'XAUTHORITY': str(authority)},
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
print(f'Sharing physical desktop {display} on 127.0.0.1:{port}', flush=True)
os.execv('/usr/bin/x11vnc', ['x11vnc', '-norc', '-display', display,
          '-auth', str(authority), '-localhost', '-listen', '127.0.0.1',
          '-no6', '-noipv6', '-nopw', '-forever', '-shared', '-repeat',
          '-nobell', '-modtweak', '-xkb', '-add_keysyms', '-seldir', 'recv',
          '-rfbport', str(port)])
