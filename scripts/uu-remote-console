#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

environment_file="$HOME/.config/uu-remote-bridge/environment"
config_dir="$HOME/.config/uu-remote-bridge"
bridge_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-console"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/uu-remote-console"
bridge_xauthority_file="$bridge_runtime_dir/Xauthority"
bridge_display_file="$bridge_runtime_dir/private-display"
bridge_focus_file="$bridge_runtime_dir/console-focus"
window_lock_file="$runtime_dir/window.lock"
script_path="$(readlink -f "$0")"
systemctl_user=(
    /usr/bin/env
    "DBUS_SESSION_BUS_ADDRESS=unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    /usr/bin/systemctl --user
)

saved_setting() {
    local name="$1"

    [[ -f "$environment_file" ]] || return 0
    /usr/bin/sed -n "s/^${name}=//p" "$environment_file" | \
        /usr/bin/tail -n 1
}

saved_vnc_port="$(saved_setting UURB_CONSOLE_VNC_PORT)"
saved_web_port="$(saved_setting UURB_CONSOLE_WEB_PORT)"
vnc_port="${UURB_CONSOLE_VNC_PORT:-${saved_vnc_port:-5920}}"
web_port="${UURB_CONSOLE_WEB_PORT:-${saved_web_port:-6080}}"
relay_vnc_port="${UURB_RELAY_VNC_PORT:-5922}"
relay_vnc_auth_file="${UURB_RELAY_VNC_AUTH_FILE:-$config_dir/relay-vnc.pass}"
novnc_root="${UURB_NOVNC_ROOT:-/usr/share/novnc}"
console_url="http://127.0.0.1:$web_port/vnc.html?autoconnect=1&resize=scale&reconnect=1"
bridge_display=""
bridge_xauthority=""
vnc_pid=""
websockify_pid=""
window_vnc_pid=""
window_remote_channel=""
region_tracker_pid=""
relay_focus_pid=""

notify_error() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send 'UU Remote' "$1"
    fi
    printf '%s\n' "$1" >&2
}

valid_port() {
    [[ "$1" =~ ^[1-9][0-9]{3,4}$ ]] &&
        ((10#$1 >= 1024 && 10#$1 <= 65535))
}

if ! valid_port "$vnc_port" || ! valid_port "$web_port" ||
   ! valid_port "$relay_vnc_port" ||
   [[ "$vnc_port" == "$web_port" ||
      "$vnc_port" == "$relay_vnc_port" ||
      "$web_port" == "$relay_vnc_port" ]]; then
    printf 'UU console ports must be distinct integers from 1024 through 65535.\n' \
        >&2
    exit 2
fi
vnc_port=$((10#$vnc_port))
web_port=$((10#$web_port))
relay_vnc_port=$((10#$relay_vnc_port))

display_ready() {
    local display="$1"
    local xauthority="$2"

    [[ "$display" =~ ^:(0|[1-9][0-9]{0,2})$ ]] &&
        [[ -r "$xauthority" ]] &&
        /usr/bin/env DISPLAY="$display" XAUTHORITY="$xauthority" \
            /usr/bin/xdpyinfo >/dev/null 2>&1
}

discover_bridge() {
    local -a arguments=()
    local auth=""
    local candidate=""
    local index
    local pid

    bridge_display=""
    bridge_xauthority=""
    if [[ -r "$bridge_display_file" ]]; then
        read -r candidate <"$bridge_display_file" || true
        if display_ready "$candidate" "$bridge_xauthority_file"; then
            bridge_display="$candidate"
            bridge_xauthority="$bridge_xauthority_file"
            return 0
        fi
    fi

    while read -r pid; do
        [[ -r "/proc/$pid/cmdline" ]] || continue
        arguments=()
        if ! mapfile -d '' -t arguments <"/proc/$pid/cmdline"; then
            continue
        fi
        candidate=""
        auth=""
        for ((index = 1; index < ${#arguments[@]}; index++)); do
            if [[ "${arguments[index]}" =~ ^:(0|[1-9][0-9]{0,2})$ ]]; then
                candidate="${arguments[index]}"
            elif [[ "${arguments[index]}" == -auth &&
                    $((index + 1)) -lt ${#arguments[@]} ]]; then
                auth="${arguments[index + 1]}"
                index=$((index + 1))
            fi
        done
        if [[ "$auth" == "$bridge_xauthority_file" ]] &&
           display_ready "$candidate" "$auth"; then
            bridge_display="$candidate"
            bridge_xauthority="$auth"
            return 0
        fi
    done < <(/usr/bin/pgrep -u "$UID" -x Xvfb || true)
    return 1
}

listener_present() {
    /usr/bin/ss -H -ltn "sport = :$1" 2>/dev/null | \
        /usr/bin/grep -q .
}

wait_for_bridge() {
    for _ in {1..160}; do
        if discover_bridge; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

find_client_window() {
    local name
    local window

    discover_bridge || return 1
    while read -r window; do
        name="$(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowname "$window" 2>/dev/null || true
        )"
        # Transient UU toasts share the title but are not managed windows.
        if [[ "$name" == '网易UU远程' || "$name" == *UU* ]] &&
           /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
               /usr/bin/xprop -id "$window" WM_STATE 2>/dev/null | \
               /usr/bin/grep -q 'WM_STATE(WM_STATE)'; then
            printf '%s\n' "$window"
        fi
    done < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --class 'gameviewer.exe' 2>/dev/null ||
            true
    )
}

find_relay_window() {
    local relay=""
    discover_bridge || return 1
    relay="$(
        /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool search --onlyvisible \
                --name '^Ubuntu-Desktop-Relay$' 2>/dev/null | \
            /usr/bin/tail -n 1 || true
    )"
    if [[ -z "$relay" ]]; then
        relay="$(
            /usr/bin/env DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool search --onlyvisible --all \
                    --class 'realvnc-vncviewer' \
                    --name '^127\.0\.0\.1:.* - RealVNC Viewer$' 2>/dev/null | \
                /usr/bin/tail -n 1 || true
        )"
    fi
    [[ -n "$relay" ]] || return 1
    printf '%s\n' "$relay"
}

focus_client() {
    local client_window=""

    discover_bridge || return 1
    /usr/bin/install -d -m 0700 "$bridge_runtime_dir"
    printf '%s\n' "$$" >"$bridge_focus_file"
    chmod 0600 "$bridge_focus_file"
    client_window="$(find_client_window | /usr/bin/tail -n 1)"
    if [[ -n "$client_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowmap "$client_window" \
                windowactivate --sync "$client_window" >/dev/null 2>&1 || true
    fi
}

release_client() {
    local client_window=""
    local relay_window=""

    rm -f "$bridge_focus_file"
    discover_bridge || return 0
    client_window="$(find_client_window | /usr/bin/tail -n 1)"
    if [[ -n "$client_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowminimize "$client_window" \
                >/dev/null 2>&1 || true
    fi
    relay_window="$(find_relay_window || true)"
    if [[ -n "$relay_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowactivate "$relay_window" \
                >/dev/null 2>&1 || true
    fi
}

cleanup_server() {
    local pid

    trap - EXIT INT TERM HUP
    for pid in "$websockify_pid" "$vnc_pid"; do
        if [[ -n "$pid" ]]; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    done
    release_client || true
    rm -f "$runtime_dir/url" "$runtime_dir/display"
}

cleanup_window() {
    trap - EXIT INT TERM HUP
    if [[ -n "$region_tracker_pid" ]]; then
        kill "$region_tracker_pid" >/dev/null 2>&1 || true
        wait "$region_tracker_pid" 2>/dev/null || true
    fi
    if [[ -n "$window_vnc_pid" ]]; then
        kill "$window_vnc_pid" >/dev/null 2>&1 || true
        wait "$window_vnc_pid" 2>/dev/null || true
    fi
    release_client || true
    rm -f "$runtime_dir/window.port"
}

restore_private_focus() {
    local client_window=""
    local relay_window=""

    if [[ -e "$bridge_focus_file" ]]; then
        client_window="$(find_client_window | /usr/bin/tail -n 1)"
        if [[ -n "$client_window" ]]; then
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool windowactivate "$client_window" \
                    >/dev/null 2>&1 || true
            return 0
        fi
    fi
    relay_window="$(find_relay_window)"
    if [[ -n "$relay_window" ]]; then
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdotool windowactivate "$relay_window" \
                >/dev/null 2>&1 || true
    fi
}

cleanup_relay_vnc() {
    trap - EXIT INT TERM HUP
    if [[ -n "$relay_focus_pid" ]]; then
        kill "$relay_focus_pid" >/dev/null 2>&1 || true
        wait "$relay_focus_pid" 2>/dev/null || true
    fi
    if [[ -n "$vnc_pid" ]]; then
        kill "$vnc_pid" >/dev/null 2>&1 || true
        wait "$vnc_pid" 2>/dev/null || true
    fi
    restore_private_focus || true
}

prepare_relay_vnc_auth() {
    local password=""
    local quoted_temporary=""
    local temporary=""
    local vnc_password=""

    if [[ -s "$relay_vnc_auth_file" ]]; then
        chmod 0600 "$relay_vnc_auth_file"
        return 0
    fi
    if [[ ! -x /usr/bin/secret-tool ]]; then
        printf 'The relay VNC credential is missing and secret-tool is unavailable.\n' \
            >&2
        return 1
    fi
    password="$(
        /usr/bin/secret-tool lookup service uu-desktop-bridge \
            username "$USER" 2>/dev/null || true
    )"
    if [[ -z "$password" ]]; then
        printf 'The relay VNC credential could not be recovered from the keyring.\n' \
            >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$config_dir"
    temporary="$(/usr/bin/mktemp "$config_dir/relay-vnc.pass.XXXXXX")"
    # Classic VNC authentication consumes at most eight password bytes.
    # Truncate explicitly so x11vnc does not reject a longer RDP credential
    # and desynchronize its interactive confirmation prompts.
    vnc_password="$(LC_ALL=C printf '%.8s' "$password")"
    printf -v quoted_temporary '%q' "$temporary"
    if ! printf '%s\n%s\ny\n' "$vnc_password" "$vnc_password" |
        /usr/bin/script -qefc \
            "/usr/bin/x11vnc -storepasswd $quoted_temporary" /dev/null \
            >/dev/null 2>&1; then
        rm -f "$temporary"
        unset password vnc_password
        printf 'The relay VNC credential could not be generated.\n' >&2
        return 1
    fi
    unset password vnc_password
    chmod 0600 "$temporary"
    mv -f "$temporary" "$relay_vnc_auth_file"
}

activate_existing_window() {
    local window=""

    [[ -n "${DISPLAY:-}" ]] || return 1
    window="$(find_viewer_window)" || return 1
    /usr/bin/xdotool windowactivate --sync "$window" >/dev/null 2>&1
}

choose_window_port() {
    local candidate=$((vnc_port + 1))

    for _ in {1..64}; do
        if ((candidate > 65535)); then
            candidate=5900
        fi
        if [[ "$candidate" != "$web_port" ]] &&
           ! listener_present "$candidate"; then
            printf '%s\n' "$candidate"
            return 0
        fi
        candidate=$((candidate + 1))
    done
    return 1
}

ensure_bridge() {
    local bridge_process=false

    if discover_bridge; then
        return 0
    fi
    if /usr/bin/pgrep -u "$UID" -f \
        '(^|/)uu-remote-bridge($|[[:space:]])' >/dev/null; then
        bridge_process=true
    fi
    if [[ "$bridge_process" == false ]]; then
        "${systemctl_user[@]}" start uu-remote-bridge.service || return 1
    fi
    wait_for_bridge
}

serve_relay_vnc() {
    local connected=false
    local connected_checks=0
    local idle_checks=0
    local relay_window=""
    local ready=false

    for command in /usr/bin/script /usr/bin/ss /usr/bin/x11vnc \
        /usr/bin/xdotool /usr/bin/xdpyinfo; do
        if [[ ! -x "$command" ]]; then
            printf 'UU relay VNC dependency is missing: %s\n' "$command" >&2
            return 1
        fi
    done
    if ! ensure_bridge; then
        printf 'The Ubuntu desktop bridge could not start.\n' >&2
        return 1
    fi
    if ! prepare_relay_vnc_auth; then
        return 1
    fi
    if listener_present "$relay_vnc_port"; then
        printf 'UU relay VNC port %s is already in use.\n' \
            "$relay_vnc_port" >&2
        return 1
    fi
    relay_window="$(find_relay_window)"
    if [[ -z "$relay_window" ]]; then
        printf 'The Ubuntu desktop relay window is unavailable.\n' >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$state_dir"
    trap cleanup_relay_vnc EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        -id "$relay_window" \
        -rfbport "$relay_vnc_port" \
        -listen 127.0.0.1 \
        -localhost \
        -no6 \
        -rfbauth "$relay_vnc_auth_file" \
        -forever \
        -shared \
        -noxdamage \
        -nowf \
        -noscr \
        -desktop 'OptiPlex-7090 Physical Desktop' \
        -quiet \
        >>"$state_dir/relay-x11vnc.log" 2>&1 &
    vnc_pid=$!

    for _ in {1..80}; do
        if listener_present "$relay_vnc_port" &&
           kill -0 "$vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'The Ubuntu desktop relay VNC listener did not start.\n' >&2
        return 1
    fi

    for _ in {1..300}; do
        if /usr/bin/ss -H -tn state established \
            "sport = :$relay_vnc_port" 2>/dev/null |
            /usr/bin/grep -q .; then
            connected_checks=$((connected_checks + 1))
            if ((connected_checks >= 3)); then
                connected=true
                break
            fi
        else
            connected_checks=0
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.2
    done
    if [[ "$connected" != true ]]; then
        printf 'No relay VNC viewer connected within 60 seconds.\n' >&2
        return 1
    fi

    (
        while kill -0 "$vnc_pid" >/dev/null 2>&1; do
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool windowactivate "$relay_window" \
                    >/dev/null 2>&1 || true
            sleep 0.25
        done
    ) &
    relay_focus_pid=$!

    while kill -0 "$vnc_pid" >/dev/null 2>&1; do
        if /usr/bin/ss -H -tn state established \
            "sport = :$relay_vnc_port" 2>/dev/null |
            /usr/bin/grep -q .; then
            idle_checks=0
        else
            idle_checks=$((idle_checks + 1))
            if ((idle_checks >= 25)); then
                break
            fi
        fi
        sleep 0.2
    done
}

# Filter xdpyinfo output on stdin down to "WIDTH HEIGHT".
display_size() {
    /usr/bin/awk '/dimensions:/ {
        split($2, size, "x"); print size[1], size[2]; exit }'
}

# Reduce the `xdotool getwindowgeometry --shell` records on stdin to the
# WxH+X+Y bounding box of the windows connected to the largest one, clamped to
# the screen size given as $1 and $2. The remote-control view and popups are
# separate top-level windows that overlap it, so following only the main
# window crops them. A distant window such as a corner toast is left out: the
# gap up to it would show the desktop relay, which forwards the mouse to the
# real desktop.
region_of_windows() {
    /usr/bin/awk -F= -v root_w="$1" -v root_h="$2" '
        $1 == "X" { x = $2 }
        $1 == "Y" { y = $2 }
        $1 == "WIDTH" { w = $2 }
        $1 == "HEIGHT" {
            h = $2
            if (w >= 40 && h >= 40) {
                x2 = x + w; y2 = y + h
                if (x < 0) x = 0
                if (y < 0) y = 0
                if (x2 > root_w) x2 = root_w
                if (y2 > root_h) y2 = root_h
                if (x2 > x && y2 > y) {
                    n++
                    left[n] = x; top[n] = y; right[n] = x2; bottom[n] = y2
                }
            }
        }
        END {
            if (!n) exit
            seed = 0
            best = -1
            for (i = 1; i <= n; i++) {
                area = (right[i] - left[i]) * (bottom[i] - top[i])
                if (area > best) { best = area; seed = i }
            }
            joined[seed] = 1
            do {
                grew = 0
                for (i = 1; i <= n; i++) {
                    if (joined[i]) continue
                    for (j = 1; j <= n; j++) {
                        if (joined[j] && left[i] <= right[j] &&
                            left[j] <= right[i] && top[i] <= bottom[j] &&
                            top[j] <= bottom[i]) {
                            joined[i] = 1; grew = 1; break
                        }
                    }
                }
            } while (grew)
            count = 0
            for (i = 1; i <= n; i++) {
                if (!joined[i]) continue
                if (!count || left[i] < min_x) min_x = left[i]
                if (!count || top[i] < min_y) min_y = top[i]
                if (!count || right[i] > max_x) max_x = right[i]
                if (!count || bottom[i] > max_y) max_y = bottom[i]
                count++
            }
            printf "%dx%d+%d+%d\n", max_x - min_x, max_y - min_y,
                min_x, min_y
        }'
}

# Print that region for the visible UU windows on the private display.
window_region() {
    discover_bridge || return 1
    {
        local window
        while read -r window; do
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool getwindowgeometry --shell "$window" \
                2>/dev/null || true
        done < <(
            /usr/bin/env DISPLAY="$bridge_display" \
                XAUTHORITY="$bridge_xauthority" \
                /usr/bin/xdotool search --onlyvisible \
                --class 'gameviewer.exe' 2>/dev/null || true
        )
    } | region_of_windows "$1" "$2"
}

# Print the id of the local UU viewer window. Its class is retagged once
# (retag_viewer), so both the TigerVNC class and the UU one are accepted.
find_viewer_window() {
    local window

    while read -r window; do
        if [[ "$(
            /usr/bin/xdotool getwindowname "$window" 2>/dev/null || true
        )" == 'UU Remote - TigerVNC' ]]; then
            printf '%s\n' "$window"
            return 0
        fi
    done < <(
        /usr/bin/xdotool search --class '^(TigerVNC Viewer|UU-Remote)$' \
            2>/dev/null || true
    )
    return 1
}

# Give the viewer window its own class, matching StartupWMClass in the
# launcher: the system TigerVNC launcher claims "TigerVNC Viewer" as well, so
# GNOME showed the UU window under the TigerVNC icon and menu.
retag_viewer() {
    /usr/bin/xdotool set_window --classname uu-remote --class UU-Remote \
        "$1" >/dev/null 2>&1
}

# Print "WIDTH HEIGHT" of the local UU viewer window, which is where the
# picture ends up. Its size follows the monitor, maximize and full screen.
viewer_size() {
    local window

    window="$(find_viewer_window)" || return 1
    /usr/bin/xdotool getwindowgeometry --shell "$window" 2>/dev/null | \
        /usr/bin/awk -F= '
        $1 == "WIDTH" { w = $2 }
        $1 == "HEIGHT" { h = $2 }
        END { if (w > 0 && h > 0) print w, h }'
}

# Print the largest zoom (0.25-3, two decimals) at which a $3 x $4 region
# fits inside a $1 x $2 window. The 4 pixels cover x11vnc rounding the scaled
# width up to a multiple of 4, which would otherwise add a scroll bar.
fit_scale() {
    /usr/bin/awk -v win_w="$1" -v win_h="$2" \
        -v width="$3" -v height="$4" 'BEGIN {
            scale = (win_w - 4) / width
            fit_h = (win_h - 4) / height
            if (fit_h < scale) scale = fit_h
            if (scale > 3) scale = 3
            if (scale < 0.25) scale = 0.25
            printf "%.2f\n", int(scale * 100) / 100
        }'
}

# Run an x11vnc remote-control option against the window's server.
x11vnc_control() {
    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        X11VNC_REMOTE="$window_remote_channel" \
        DISPLAY="$bridge_display" XAUTHORITY="$bridge_xauthority" \
        /usr/bin/x11vnc "$@" 2>/dev/null
}

# Send one "key:value" command to the window's x11vnc server and wait until a
# query shows it took effect. x11vnc silently drops a command that arrives
# while it is still busy, so a sent command is not an applied one.
x11vnc_remote() {
    local answer
    local attempt

    for attempt in 1 2 3 4 5; do
        x11vnc_control -R "$1" >/dev/null || return 1
        sleep 0.3
        answer="$(x11vnc_control -Q "${1%%:*}" | /usr/bin/tail -n 1)"
        [[ "$answer" == "ans=$1" ]] && return 0
    done
    return 1
}

# Keep the exported region on the visible UU windows, and the zoom on the
# size of the local viewer window, while they open, move, resize and close.
# Runs until the x11vnc server it controls exits.
track_window_region() {
    local absent=0
    local current="$1"
    local current_h=""
    local current_scale="1.00"
    local region=""
    local retagged=""
    local scale=""
    local viewer=""
    local win_h=""
    local win_size=""
    local win_w=""

    while kill -0 "$window_vnc_pid" >/dev/null 2>&1; do
        sleep 0.5
        region="$(window_region "$2" "$3" || true)"
        if [[ -z "$region" ]]; then
            # With no UU window on show the clip would expose the desktop
            # relay, so bring the window back, and close the viewer if it
            # cannot be brought back.
            absent=$((absent + 1))
            if ((absent == 2)); then
                focus_client || true
            elif ((absent >= 16)); then
                kill "$window_vnc_pid" >/dev/null 2>&1 || true
                return 0
            fi
            continue
        fi
        absent=0
        if [[ "$region" != "$current" ]]; then
            if x11vnc_remote "clip:$region"; then
                current="$region"
            fi
        fi
        if [[ -z "$retagged" ]]; then
            viewer="$(find_viewer_window || true)"
            if [[ -n "$viewer" ]] && retag_viewer "$viewer"; then
                retagged=true
            fi
        fi
        win_size="$(viewer_size || true)"
        [[ -n "$current" && -n "$win_size" ]] || continue
        read -r win_w win_h <<<"$win_size"
        current_h="${current#*x}"
        current_h="${current_h%%+*}"
        scale="$(fit_scale "$win_w" "$win_h" "${current%%x*}" "$current_h")"
        # The viewer resizes its window to the picture when they matched, so
        # only follow real changes or a picture that no longer fits, or the
        # zoom would creep down by itself.
        if /usr/bin/awk -v new="$scale" -v old="$current_scale" \
                -v width="${current%%x*}" -v height="$current_h" \
                -v win_w="$win_w" -v win_h="$win_h" 'BEGIN {
                change = new - old
                if (change < 0) change = -change
                shown_w = int((int(old * width + 0.000001) + 3) / 4) * 4
                shown_h = int(old * height + 0.000001)
                too_big = new < old && (shown_w > win_w || shown_h > win_h)
                exit !(change / old >= 0.03 || too_big)
            }' && x11vnc_remote "scale:$scale"; then
            current_scale="$scale"
        fi
    done
}

open_window() {
    local attempt
    local client_window=""
    local command
    local ready=false
    local region=""
    local root_h=""
    local root_w=""
    local viewer_status=0
    local window_port=""
    local -a view_args=()

    if [[ -z "${DISPLAY:-}" ]]; then
        notify_error 'Open UU Remote from a logged-in graphical desktop.'
        return 1
    fi
    for command in /usr/bin/flock /usr/bin/ss /usr/bin/vncviewer \
        /usr/bin/x11vnc /usr/bin/xdotool /usr/bin/xdpyinfo; do
        if [[ ! -x "$command" ]]; then
            notify_error "UU window dependency is missing: $command"
            return 1
        fi
    done

    /usr/bin/install -d -m 0700 "$runtime_dir" "$state_dir"
    exec 9>"$window_lock_file"
    if ! /usr/bin/flock -n 9; then
        if activate_existing_window; then
            return 0
        fi
        notify_error 'The UU Remote window is already starting.'
        return 1
    fi
    if ! ensure_bridge; then
        notify_error 'The Ubuntu desktop bridge could not start.'
        return 1
    fi

    for _ in {1..120}; do
        client_window="$(find_client_window | /usr/bin/tail -n 1)"
        [[ -n "$client_window" ]] && break
        sleep 0.1
    done
    if [[ -z "$client_window" ]]; then
        notify_error 'The UU management window did not become ready.'
        return 1
    fi
    window_port="$(choose_window_port)" || {
        notify_error 'No free loopback port is available for the UU window.'
        return 1
    }

    printf '%s\n' "$window_port" >"$runtime_dir/window.port"
    chmod 0600 "$runtime_dir/window.port"
    trap cleanup_window EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    focus_client

    # Export a clipped root view of the private display, not one window: -id
    # shows popups as black rectangles, and -sid crops the remote-control
    # window to the main window. The clip follows the visible UU windows and
    # the zoom follows the viewer window (track_window_region), because the
    # viewer can only shrink the picture and its window size depends on the
    # monitor it opens on.
    read -r root_w root_h < <(
        /usr/bin/env DISPLAY="$bridge_display" \
            XAUTHORITY="$bridge_xauthority" \
            /usr/bin/xdpyinfo 2>/dev/null | display_size
    ) || true
    if [[ "$root_w" =~ ^[0-9]+$ && "$root_h" =~ ^[0-9]+$ ]]; then
        # The window that was minimized when the last viewer closed needs a
        # moment to come back; ask again halfway through.
        for attempt in {1..50}; do
            region="$(window_region "$root_w" "$root_h" || true)"
            [[ -n "$region" ]] && break
            if ((attempt == 20)); then
                focus_client || true
            fi
            sleep 0.1
        done
    fi
    if [[ -z "$region" ]]; then
        # Never export the whole screen: outside the UU windows it is the
        # live desktop relay, and the mouse would drive the real desktop.
        notify_error 'The UU window is not visible yet. Try again.'
        return 1
    fi
    view_args=(-clip "$region")
    window_remote_channel="UU_REMOTE_WINDOW_$window_port"
    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        X11VNC_REMOTE="$window_remote_channel" \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        "${view_args[@]}" \
        -rfbport "$window_port" \
        -listen 127.0.0.1 \
        -localhost \
        -no6 \
        -nopw \
        -forever \
        -shared \
        -noxdamage \
        -nowf \
        -noscr \
        -desktop 'UU Remote' \
        -quiet \
        >>"$state_dir/window-x11vnc.log" 2>&1 &
    window_vnc_pid=$!

    for _ in {1..80}; do
        if listener_present "$window_port" &&
           kill -0 "$window_vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$window_vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        notify_error 'The UU management window could not be exposed locally.'
        return 1
    fi

    track_window_region "$region" "$root_w" "$root_h" &
    region_tracker_pid=$!

    set +e
    /usr/bin/vncviewer \
        -Shared=1 \
        -Maximize=1 \
        -QualityLevel=9 \
        -RemoteResize=0 \
        -ReconnectOnError=0 \
        -AlertOnFatalError=0 \
        -SecurityTypes=None \
        "127.0.0.1::$window_port" \
        >>"$state_dir/window-viewer.log" 2>&1
    viewer_status=$?
    set -e
    return "$viewer_status"
}

serve_console() {
    local command
    local ready=false

    for command in /usr/bin/curl /usr/bin/ss /usr/bin/websockify \
        /usr/bin/x11vnc /usr/bin/xdotool /usr/bin/xdpyinfo; do
        if [[ ! -x "$command" ]]; then
            printf 'UU console dependency is missing: %s\n' "$command" >&2
            return 1
        fi
    done
    if [[ ! -f "$novnc_root/vnc.html" ]]; then
        printf 'noVNC web assets are missing from %s.\n' "$novnc_root" >&2
        return 1
    fi
    if ! wait_for_bridge; then
        printf 'The UU private X display did not become ready.\n' >&2
        return 1
    fi
    if listener_present "$vnc_port" || listener_present "$web_port"; then
        printf 'UU console port %s or %s is already in use.\n' \
            "$vnc_port" "$web_port" >&2
        return 1
    fi

    /usr/bin/install -d -m 0700 "$runtime_dir" "$state_dir"
    printf '%s\n' "$bridge_display" >"$runtime_dir/display"
    printf '%s\n' "$console_url" >"$runtime_dir/url"
    chmod 0600 "$runtime_dir/display" "$runtime_dir/url"
    trap cleanup_server EXIT INT TERM HUP

    /usr/bin/env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 \
        /usr/bin/x11vnc \
        -display "$bridge_display" \
        -auth "$bridge_xauthority" \
        -rfbport "$vnc_port" \
        -localhost \
        -no6 \
        -nopw \
        -forever \
        -shared \
        -quiet \
        -afteraccept "$script_path focus-client" \
        -gone "$script_path release-client" \
        >>"$state_dir/x11vnc.log" 2>&1 &
    vnc_pid=$!

    for _ in {1..80}; do
        if listener_present "$vnc_port" &&
           kill -0 "$vnc_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$vnc_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'x11vnc did not expose the UU private display.\n' >&2
        return 1
    fi

    /usr/bin/websockify --web="$novnc_root" \
        "127.0.0.1:$web_port" "127.0.0.1:$vnc_port" \
        >>"$state_dir/websockify.log" 2>&1 &
    websockify_pid=$!
    ready=false
    for _ in {1..80}; do
        if /usr/bin/curl --fail --silent --show-error \
            "http://127.0.0.1:$web_port/vnc.html" >/dev/null 2>&1 &&
           kill -0 "$websockify_pid" >/dev/null 2>&1; then
            ready=true
            break
        fi
        kill -0 "$websockify_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        printf 'The UU noVNC endpoint did not become ready.\n' >&2
        return 1
    fi

    printf 'UU Remote console: %s (display %s)\n' \
        "$console_url" "$bridge_display"
    set +e
    wait -n "$vnc_pid" "$websockify_pid"
    set -e
    return 1
}

launch_browser() {
    local profile="$HOME/.local/share/uu-remote-console/chrome-profile"

    /usr/bin/install -d -m 0700 "$profile"
    if [[ -x /usr/bin/google-chrome ]]; then
        exec /usr/bin/google-chrome \
            --app="$console_url" \
            --class=uu-remote-console \
            --user-data-dir="$profile" \
            --no-first-run \
            --no-default-browser-check \
            --disable-sync
    elif [[ -x /snap/bin/chromium ]]; then
        exec /snap/bin/chromium \
            --app="$console_url" \
            --class=uu-remote-console \
            --user-data-dir="$profile" \
            --no-first-run \
            --no-default-browser-check \
            --disable-sync
    fi
    exec /usr/bin/xdg-open "$console_url"
}

open_console() {
    local ready=false

    ensure_bridge || {
        notify_error 'The Ubuntu desktop bridge could not start.'
        return 1
    }

    "${systemctl_user[@]}" reset-failed uu-remote-console.service \
        >/dev/null 2>&1 || true
    if ! "${systemctl_user[@]}" start uu-remote-console.service; then
        notify_error 'The local UU Remote console could not start.'
        return 1
    fi
    for _ in {1..160}; do
        if /usr/bin/curl --fail --silent \
            "http://127.0.0.1:$web_port/vnc.html" >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 0.1
    done
    if [[ "$ready" != true ]]; then
        notify_error 'The local UU Remote console did not become ready.'
        return 1
    fi
    launch_browser
}

case "${1:-open}" in
    window)
        open_window
        ;;
    open)
        open_console
        ;;
    serve)
        serve_console
        ;;
    relay)
        serve_relay_vnc
        ;;
    relay-port)
        printf '%s\n' "$relay_vnc_port"
        ;;
    status)
        printf 'URL: %s\n' "$console_url"
        printf 'Service: %s\n' \
            "$("${systemctl_user[@]}" is-active uu-remote-console.service \
                2>/dev/null || true)"
        if discover_bridge; then
            printf 'Bridge display: %s\n' "$bridge_display"
        else
            printf 'Bridge display: unavailable\n'
        fi
        ;;
    stop)
        exec "${systemctl_user[@]}" stop uu-remote-console.service
        ;;
    url)
        printf '%s\n' "$console_url"
        ;;
    focus-client)
        focus_client
        ;;
    release-client)
        release_client
        ;;
    *)
        printf 'usage: uu-remote-console [window|open|serve|relay|relay-port|status|stop|url|focus-client|release-client]\n' \
            >&2
        exit 2
        ;;
esac
