#!/usr/bin/env bash

set -Eeuo pipefail

bridge_user="${USER:-$(id -un)}"
bridge_display="${UURB_DISPLAY:-auto}"
desktop_target="${UURB_DESKTOP_TARGET:-auto}"
desktop_relay="${UURB_DESKTOP_RELAY:-rdp}"
vnc_grab_keyboard="${UURB_VNC_GRAB_KEYBOARD:-on}"
rdp_port="${UURB_RDP_PORT:-3390}"
resolution="${UURB_RESOLUTION:-1920x1080}"
follow_desktop_resolution="${UURB_FOLLOW_DESKTOP_RESOLUTION:-off}"
grd_fd_restart_threshold="${UURB_GRD_FD_RESTART_THRESHOLD:-4096}"
text_key_delay_ms="${UURB_TEXT_KEY_DELAY_MS:-8}"
physical_key_delay_ms="${UURB_PHYSICAL_KEY_DELAY_MS:-0}"
keyboard_route="${UURB_KEYBOARD_ROUTE:-rdp}"
phone_text_mode="${UURB_PHONE_TEXT_MODE:-auto}"
network_interface="${UURB_NETWORK_INTERFACE:-all}"
cursor_guard_setting="${UURB_CURSOR_GUARD:-off}"
cursor_size_setting="${UURB_CURSOR_SIZE:-auto}"
uu_audio_setting="${UURB_UU_AUDIO:-system}"
wine_prefix="${UURB_WINEPREFIX:-$HOME/.local/share/wineprefixes/uu-remote}"
service_name="${UURB_SERVICE_NAME:-uu-remote-bridge.service}"
environment_file="$HOME/.config/uu-remote-bridge/environment"
manager_display="${DISPLAY:-}"
manager_wayland="${WAYLAND_DISPLAY:-}"
manager_session_type="${XDG_SESSION_TYPE:-}"
manager_xauthority="${XAUTHORITY:-}"
manager_bus="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus}"
systemctl_user=(
    /usr/bin/env
    "DBUS_SESSION_BUS_ADDRESS=unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus"
    /usr/bin/systemctl --user
)

if [[ "$desktop_target" != auto &&
      "$desktop_target" != xrdp &&
      "$desktop_target" != physical &&
      ! "$desktop_target" =~ ^:(0|[1-9][0-9]{0,2})(\.0)?$ ]] ||
   [[ "$bridge_display" != auto &&
      ! "$bridge_display" =~ ^:(0|[1-9][0-9]{0,2})$ ]] ||
   [[ "$desktop_relay" != rdp && "$desktop_relay" != vnc ]] ||
   [[ "$vnc_grab_keyboard" != off && "$vnc_grab_keyboard" != on ]] ||
   [[ ! "$rdp_port" =~ ^[1-9][0-9]{0,4}$ ]] ||
   [[ ! "$resolution" =~ ^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$ ]] ||
   [[ "$follow_desktop_resolution" != off &&
      "$follow_desktop_resolution" != on ]] ||
   [[ ! "$grd_fd_restart_threshold" =~ ^[0-9]+$ ]] ||
   [[ ! "$text_key_delay_ms" =~ ^[0-9]+$ ]] ||
   [[ ! "$physical_key_delay_ms" =~ ^[0-9]+$ ]] ||
   [[ "$keyboard_route" != rdp &&
      "$keyboard_route" != x11 &&
      "$keyboard_route" != auto ]] ||
   [[ "$phone_text_mode" != auto &&
      "$phone_text_mode" != keys &&
      "$phone_text_mode" != clipboard ]] ||
   [[ "$network_interface" != all &&
      "$network_interface" != default &&
      ! "$network_interface" =~ ^[a-zA-Z0-9_.:-]{1,15}$ ]] ||
   [[ "$cursor_guard_setting" != off &&
      "$cursor_guard_setting" != on ]] ||
   [[ "$uu_audio_setting" != system &&
      "$uu_audio_setting" != off ]] ||
   [[ "$cursor_size_setting" != auto &&
      ! "$cursor_size_setting" =~ ^[0-9]{1,3}$ ]] ||
   [[ "$wine_prefix" != /* ]]; then
    printf 'Invalid UURB desktop target, relay, VNC keyboard grab, display, RDP port, resolution, resolution-follow, descriptor, keyboard, network, cursor, audio, or prefix setting.\n' >&2
    exit 2
fi
vnc_grab_keyboard_value=0
if [[ "$vnc_grab_keyboard" == on ]]; then
    vnc_grab_keyboard_value=1
fi
resolution_width="${resolution%x*}"
resolution_height="${resolution#*x}"
if ((rdp_port < 1024 || rdp_port > 65535 ||
     resolution_width < 640 || resolution_width > 16384 ||
     resolution_height < 480 || resolution_height > 16384 ||
     (grd_fd_restart_threshold != 0 &&
      (grd_fd_restart_threshold < 512 ||
       grd_fd_restart_threshold > 60000)) ||
     text_key_delay_ms > 50 || physical_key_delay_ms > 50)); then
    printf 'UURB port, resolution, descriptor threshold, or keyboard delay is outside the supported range.\n' >&2
    exit 2
fi
if [[ "$cursor_size_setting" != auto ]]; then
    cursor_size_setting=$((10#$cursor_size_setting))
    if ((cursor_size_setting < 24 || cursor_size_setting > 128)); then
        printf 'UURB cursor size is outside the supported range.\n' >&2
        exit 2
    fi
fi

if [[ "$bridge_display" == auto ]]; then
    for display_number in $(/usr/bin/seq 20 99); do
        if [[ ! -e "/tmp/.X11-unix/X$display_number" &&
              ! -e "/tmp/.X${display_number}-lock" ]]; then
            bridge_display=":$display_number"
            break
        fi
    done
    if [[ "$bridge_display" == auto ]]; then
        printf 'No free private X display was found from :20 through :99.\n' >&2
        exit 1
    fi
else
    display_number="${bridge_display#:}"
    if [[ -e "/tmp/.X11-unix/X$display_number" ||
          -e "/tmp/.X${display_number}-lock" ]]; then
        printf 'Private X display %s is already in use; choose auto or another display.\n' \
            "$bridge_display" >&2
        exit 1
    fi
fi

export DISPLAY="$bridge_display"
export WINEPREFIX="$wine_prefix"
export WINEDEBUG=-all
if [[ "$uu_audio_setting" == off ]]; then
    # UU starts a WebRTC capture stream on every controller connection even
    # when the nested FreeRDP relay uses /audio-mode:2. Disable Wine's audio
    # driver only for this dedicated prefix; video and input remain intact.
    export WINEDLLOVERRIDES='winepulse.drv=d;winedbg.exe=d;mscoree,mshtml='
else
    export WINEDLLOVERRIDES='winedbg.exe=d;mscoree,mshtml='
fi
export OPENSSL_MODULES='C:\Program Files\FreeRDP\ossl-modules'
export SDL_RENDER_DRIVER=software
export UU_INPUT_BRIDGE_LOG="C:\\users\\$bridge_user\\Temp\\uu-input-bridge.log"
export UU_INPUT_BROKER_LOG="C:\\users\\$bridge_user\\Temp\\uu-input-broker.log"
export UURB_CURSOR_GUARD_LOG="C:\\users\\$bridge_user\\Temp\\uu-cursor-guard.log"
export UURB_TEXT_KEY_DELAY_MS="$text_key_delay_ms"
export UURB_PHYSICAL_KEY_DELAY_MS="$physical_key_delay_ms"
export UURB_PHONE_TEXT_MODE="$phone_text_mode"
export PATH="/opt/wine-stable/bin:/usr/bin:/bin"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/uu-remote-bridge"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/uu-remote-bridge"
compat_dir="$WINEPREFIX/compat"
libei_dir="$compat_dir/libei"
freerdp_exe="$WINEPREFIX/drive_c/Program Files/FreeRDP/sdl-freerdp.exe"
cursor_guard_dll="$compat_dir/uu-cursor-guard.dll"
cursor_guard_log="$WINEPREFIX/drive_c/users/$bridge_user/Temp/uu-cursor-guard.log"
cursor_reader_guard_log="$WINEPREFIX/drive_c/users/$bridge_user/AppData/Local/Temp/uu-cursor-guard.log"
input_bridge_dll="$compat_dir/uu-input-bridge.dll"
input_broker_exe="$compat_dir/uu-input-broker.exe"
x11_input_helper="$compat_dir/uu-x11-input"
network_filter="$compat_dir/uu-network-filter.so"
input_injector_exe="$compat_dir/uu-injector.exe"
service_control_exe="$compat_dir/uu-service-control.exe"
uu_app_dir="$WINEPREFIX/drive_c/Program Files/Netease/GameViewer"
terminal_bridge_helper="$compat_dir/uu-terminal-bridge"
terminal_proxy_compat="$compat_dir/uu-terminal-proxy.exe"
terminal_proxy_exe="$uu_app_dir/bin/powershell.exe"
terminal_config_file="$uu_app_dir/bin/uu-terminal-bridge.runtime"
xauth_file="$runtime_dir/Xauthority"
x11_input_ready_file="$runtime_dir/x11-input.port"
terminal_ready_file="$runtime_dir/terminal.port"
private_display_file="$runtime_dir/private-display"
console_focus_file="$runtime_dir/console-focus"
wine_stop_bin="$HOME/.local/libexec/uu-remote-stop-wine-prefix"

if [[ ! -x "$libei_dir/libei.so.1.2.1" ||
      ! -L "$libei_dir/libei.so.1" ]]; then
    printf 'The patched libei keymap-FD backport is missing; reinstall the bridge.\n' >&2
    exit 1
fi

xvfb_pid=""
openbox_pid=""
grd_pid=""
freerdp_pid=""
desktop_x11vnc_pid=""
vncviewer_pid=""
winlogon_pid=""
input_broker_pid=""
x11_input_pid=""
terminal_bridge_pid=""
server_supervisor_pid=""
grd_user_service_was_active=false
desktop_bus=""
desktop_display=""
desktop_wayland=""
desktop_session_type=""
desktop_xauthority=""
desktop_session_id=""
desktop_session_service=""
desktop_session_seat=""
active_network_interface=""
active_keyboard_route="rdp"
x11_input_semantic_only=false
desktop_vnc_port=""
cursor_size=""
x11_input_port=""
x11_input_token=""
terminal_bridge_port=""
terminal_bridge_token=""

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"
}

desktop_geometry() {
    local height
    local selected_xauthority
    local width

    [[ "$desktop_session_type" == x11 && -n "$desktop_display" ]] ||
        return 1
    selected_xauthority="$desktop_xauthority"
    if [[ -z "$selected_xauthority" && -f "$HOME/.Xauthority" ]]; then
        selected_xauthority="$HOME/.Xauthority"
    fi
    read -r width height < <(
        /usr/bin/env \
            DISPLAY="$desktop_display" \
            XAUTHORITY="$selected_xauthority" \
            /usr/bin/xdotool getdisplaygeometry 2>/dev/null
    ) || return 1
    [[ "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ ]] || return 1
    # Ignore transient tiny RDP windows. They are useful client-side sizes,
    # but not stable canvases for an unattended shared workstation.
    ((width >= 1024 && width <= 16384 &&
      height >= 720 && height <= 16384)) || return 1
    printf '%sx%s\n' "$width" "$height"
}

persist_relay_resolution() {
    local new_resolution="$1"
    local temporary

    [[ -f "$environment_file" ]] || return 1
    temporary="$(/usr/bin/mktemp \
        "$HOME/.config/uu-remote-bridge/.environment.XXXXXX")" || return 1
    if ! /usr/bin/awk -v value="$new_resolution" '
        BEGIN { replaced = 0 }
        /^UURB_RESOLUTION=/ {
            if (!replaced) {
                print "UURB_RESOLUTION=" value
                replaced = 1
            }
            next
        }
        { print }
        END {
            if (!replaced)
                print "UURB_RESOLUTION=" value
        }
    ' "$environment_file" >"$temporary"; then
        rm -f "$temporary"
        return 1
    fi
    chmod 0600 "$temporary"
    mv "$temporary" "$environment_file"
}

align_resolution_at_startup() {
    local selected_resolution

    [[ "$follow_desktop_resolution" == on ]] || return 0
    if [[ "$desktop_relay" != vnc || "$desktop_session_type" != x11 ]]; then
        log 'Desktop-resolution following requires the VNC relay and an X11 target; retaining the saved size.'
        return 0
    fi
    selected_resolution="$(desktop_geometry || true)"
    if [[ -z "$selected_resolution" ||
          "$selected_resolution" == "$resolution" ]]; then
        return 0
    fi
    if ! persist_relay_resolution "$selected_resolution"; then
        log 'Could not persist the followed desktop resolution.'
        return 1
    fi
    log "Following the selected desktop resolution: $resolution -> $selected_resolution."
    resolution="$selected_resolution"
    resolution_width="${resolution%x*}"
    resolution_height="${resolution#*x}"
}

raise_open_file_limit() {
    local hard_limit
    local soft_limit
    local target_limit=65536

    soft_limit="$(ulimit -Sn)"
    hard_limit="$(ulimit -Hn)"
    if [[ "$hard_limit" != unlimited ]] &&
       ((hard_limit < target_limit)); then
        target_limit="$hard_limit"
    fi
    if [[ "$soft_limit" != unlimited ]] &&
       ((soft_limit < target_limit)); then
        if ! ulimit -Sn "$target_limit"; then
            log "Could not raise the open-file limit above $soft_limit."
            return 0
        fi
        log "Raised the open-file limit from $soft_limit to $target_limit."
    fi
}

raise_open_file_limit

select_network_interface() {
    local candidate

    [[ "$network_interface" != all ]] || return 0
    if [[ "$network_interface" == default ]]; then
        candidate="$(default_network_interface)"
    else
        candidate="$network_interface"
    fi
    if [[ -n "$candidate" && -d "/sys/class/net/$candidate" ]]; then
        active_network_interface="$candidate"
        log "UU adapter selection is limited to $candidate plus loopback."
    else
        log "Configured UU adapter $network_interface is unavailable; preserving the unfiltered adapter list."
    fi
}

default_network_interface() {
    /usr/bin/ip -4 route show default 2>/dev/null | \
        /usr/bin/awk '
            {
                interface = ""
                route_metric = 0
                for (i = 1; i <= NF; ++i) {
                    if ($i == "dev")
                        interface = $(i + 1)
                    else if ($i == "metric")
                        route_metric = $(i + 1)
                }
                if (interface != "")
                    print route_metric, interface
            }
        ' | /usr/bin/sort -n -k1,1 | /usr/bin/awk 'NR == 1 {print $2}'
}

resolve_cursor_size() {
    local -a display_environment
    local detected=""

    if [[ "$cursor_size_setting" != auto ]]; then
        cursor_size="$cursor_size_setting"
    elif [[ -n "$desktop_display" ]]; then
        display_environment=(
            /usr/bin/env
            "DISPLAY=$desktop_display"
        )
        if [[ -n "$desktop_xauthority" ]]; then
            display_environment+=("XAUTHORITY=$desktop_xauthority")
        fi
        detected="$(
            "${display_environment[@]}" /usr/bin/xrdb -query 2>/dev/null | \
                /usr/bin/awk '
                    $1 == "Xcursor.size:" && $2 ~ /^[0-9]+$/ {
                        if (length($2) <= 3)
                            print $2
                        exit
                    }
                '
        )"
    fi

    if [[ "$cursor_size_setting" == auto ]]; then
        if [[ "$detected" =~ ^[0-9]{1,3}$ ]]; then
            detected=$((10#$detected))
        fi
        if [[ "$detected" =~ ^[0-9]+$ ]] &&
           ((detected >= 24 && detected <= 128)); then
            cursor_size="$detected"
        else
            # GNOME's gsettings value is logical and may omit compositor scale.
            cursor_size=48
        fi
    fi

    export UURB_CURSOR_SIZE="$cursor_size"
    log "UU cursor compatibility size is ${cursor_size}x${cursor_size}."
}

cleanup() {
    local display_lock
    local display_socket
    local lock_pid
    local pid
    local processes_alive

    trap - EXIT INT TERM HUP

    rm -f \
        "$terminal_config_file" \
        "${terminal_config_file}.$$.tmp"

    for pid in \
        "$server_supervisor_pid" \
        "$input_broker_pid" \
        "$x11_input_pid" \
        "$terminal_bridge_pid" \
        "$winlogon_pid" \
        "$vncviewer_pid" \
        "$freerdp_pid" \
        "$desktop_x11vnc_pid" \
        "$grd_pid" \
        "$openbox_pid" \
        "$xvfb_pid"; do
        if [[ -n "$pid" ]]; then
            kill "$pid" >/dev/null 2>&1 || true
        fi
    done

    for _ in {1..10}; do
        processes_alive=false
        for pid in \
            "$server_supervisor_pid" \
            "$input_broker_pid" \
            "$x11_input_pid" \
            "$terminal_bridge_pid" \
            "$winlogon_pid" \
            "$vncviewer_pid" \
            "$freerdp_pid" \
            "$desktop_x11vnc_pid" \
            "$grd_pid" \
            "$openbox_pid" \
            "$xvfb_pid"; do
            if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
                processes_alive=true
                break
            fi
        done
        [[ "$processes_alive" == false ]] && break
        sleep 0.1
    done

    for pid in \
        "$server_supervisor_pid" \
        "$input_broker_pid" \
        "$x11_input_pid" \
        "$terminal_bridge_pid" \
        "$winlogon_pid" \
        "$vncviewer_pid" \
        "$freerdp_pid" \
        "$desktop_x11vnc_pid" \
        "$grd_pid" \
        "$openbox_pid" \
        "$xvfb_pid"; do
        if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
            kill -KILL "$pid" >/dev/null 2>&1 || true
        fi
    done

    "$wine_stop_bin" \
        "$WINEPREFIX" /opt/wine-stable/bin/wineserver || true

    display_lock="/tmp/.X${display_number}-lock"
    display_socket="/tmp/.X11-unix/X${display_number}"
    lock_pid="$(
        if [[ -r "$display_lock" ]]; then
            /usr/bin/tr -d '[:space:]' 2>/dev/null <"$display_lock" || true
        fi
    )"
    if [[ -n "$xvfb_pid" && "$lock_pid" == "$xvfb_pid" &&
          ! -d "/proc/$xvfb_pid" ]]; then
        rm -f "$display_lock" "$display_socket"
    fi

    if [[ "$grd_user_service_was_active" == true ]]; then
        "${systemctl_user[@]}" start gnome-remote-desktop.service \
            >/dev/null 2>&1 || true
    fi

    rm -f \
        "$xauth_file" \
        "$x11_input_ready_file" \
        "$terminal_ready_file" \
        "$private_display_file" \
        "$console_focus_file"
}

trap cleanup EXIT
trap 'exit 0' INT TERM HUP

process_environment_value() {
    local name="$1"
    local pid="$2"

    /usr/bin/tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | \
        /usr/bin/sed -n "s/^${name}=//p" | /usr/bin/head -n 1
}

refresh_manager_environment() {
    local environment
    local value

    environment="$(
        "${systemctl_user[@]}" show-environment 2>/dev/null || true
    )"

    value="$(
        printf '%s\n' "$environment" |
            /usr/bin/sed -n 's/^DISPLAY=//p' |
            /usr/bin/head -n 1
    )"
    manager_display="${value:-$manager_display}"
    value="$(
        printf '%s\n' "$environment" |
            /usr/bin/sed -n 's/^WAYLAND_DISPLAY=//p' |
            /usr/bin/head -n 1
    )"
    manager_wayland="${value:-$manager_wayland}"
    value="$(
        printf '%s\n' "$environment" |
            /usr/bin/sed -n 's/^XDG_SESSION_TYPE=//p' |
            /usr/bin/head -n 1
    )"
    manager_session_type="${value:-$manager_session_type}"
    value="$(
        printf '%s\n' "$environment" |
            /usr/bin/sed -n 's/^XAUTHORITY=//p' |
            /usr/bin/head -n 1
    )"
    manager_xauthority="${value:-$manager_xauthority}"
    value="$(
        printf '%s\n' "$environment" |
            /usr/bin/sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' |
            /usr/bin/head -n 1
    )"
    manager_bus="${value:-$manager_bus}"
}

normalized_x_display() {
    local display="$1"

    printf '%s\n' "${display%%.*}"
}

desktop_candidate_matches_target() {
    local candidate_display="$1"
    local candidate_service="$2"
    local candidate_seat="$3"
    local candidate_bus="$4"
    local normalized_candidate
    local normalized_manager
    local normalized_target

    case "$desktop_target" in
        xrdp)
            [[ "$candidate_service" == xrdp-sesman ]]
            ;;
        physical)
            normalized_candidate="$(normalized_x_display "$candidate_display")"
            normalized_manager="$(normalized_x_display "$manager_display")"
            [[ -n "$candidate_seat" || "$candidate_service" == gdm-* ||
               ( "$candidate_bus" == "$manager_bus" &&
                 -n "$manager_display" &&
                 "$normalized_candidate" == "$normalized_manager" ) ]]
            ;;
        :*)
            normalized_candidate="$(normalized_x_display "$candidate_display")"
            normalized_target="$(normalized_x_display "$desktop_target")"
            [[ -n "$candidate_display" &&
               "$normalized_candidate" == "$normalized_target" ]]
            ;;
        *)
            return 1
            ;;
    esac
}

select_desktop_candidate() {
    desktop_bus="$1"
    desktop_display="$2"
    desktop_wayland="$3"
    desktop_session_type="$4"
    desktop_xauthority="$5"
    desktop_session_id="$6"
    desktop_session_service="$7"
    desktop_session_seat="$8"
}

discover_desktop_session() {
    local candidate_bus
    local candidate_display
    local candidate_session_type
    local candidate_session_id
    local candidate_session_service
    local candidate_session_seat
    local candidate_state
    local candidate_wayland
    local candidate_xauthority
    local fallback_bus=""
    local fallback_display=""
    local fallback_session_type=""
    local fallback_wayland=""
    local fallback_xauthority=""
    local fallback_session_id=""
    local fallback_session_service=""
    local fallback_session_seat=""
    local pid

    # The user service can start before GDM imports the graphical session
    # variables. Refresh them while waiting instead of caching the boot race.
    refresh_manager_environment

    while read -r pid; do
        [[ -n "$pid" && -r "/proc/$pid/environ" ]] || continue
        candidate_bus="$(process_environment_value \
            DBUS_SESSION_BUS_ADDRESS "$pid")"
        candidate_display="$(process_environment_value DISPLAY "$pid")"
        candidate_wayland="$(process_environment_value WAYLAND_DISPLAY "$pid")"
        candidate_xauthority="$(process_environment_value XAUTHORITY "$pid")"
        candidate_session_type="$(process_environment_value \
            XDG_SESSION_TYPE "$pid")"
        candidate_session_service=""
        candidate_session_seat=""
        [[ -n "$candidate_bus" ]] || continue
        if [[ "$candidate_bus" == "$manager_bus" ]]; then
            candidate_display="${candidate_display:-$manager_display}"
            candidate_wayland="${candidate_wayland:-$manager_wayland}"
            candidate_session_type="${candidate_session_type:-$manager_session_type}"
            candidate_xauthority="${candidate_xauthority:-$manager_xauthority}"
        fi
        [[ -n "$candidate_display" || -n "$candidate_wayland" ]] || continue
        candidate_session_id="$(
            /usr/bin/sed -n \
                's#.*session-\([^/]*\)\.scope.*#\1#p' \
                "/proc/$pid/cgroup" 2>/dev/null | /usr/bin/head -n 1
        )"
        if [[ -n "$candidate_session_id" ]]; then
            candidate_state="$(
                /usr/bin/loginctl show-session "$candidate_session_id" \
                    --property=State --value 2>/dev/null || true
            )"
            [[ "$candidate_state" == active || \
               "$candidate_state" == online ]] || continue
            candidate_session_service="$(
                /usr/bin/loginctl show-session "$candidate_session_id" \
                    --property=Service --value 2>/dev/null || true
            )"
            candidate_session_seat="$(
                /usr/bin/loginctl show-session "$candidate_session_id" \
                    --property=Seat --value 2>/dev/null || true
            )"
        fi

        if [[ "$desktop_target" != auto ]]; then
            if desktop_candidate_matches_target \
                "$candidate_display" "$candidate_session_service" \
                "$candidate_session_seat" "$candidate_bus"; then
                select_desktop_candidate \
                    "$candidate_bus" "$candidate_display" \
                    "$candidate_wayland" "$candidate_session_type" \
                    "$candidate_xauthority" "$candidate_session_id" \
                    "$candidate_session_service" "$candidate_session_seat"
                return 0
            fi
            continue
        fi

        if [[ -z "$fallback_bus" ]]; then
            fallback_bus="$candidate_bus"
            fallback_display="$candidate_display"
            fallback_wayland="$candidate_wayland"
            fallback_session_type="$candidate_session_type"
            fallback_xauthority="$candidate_xauthority"
            fallback_session_id="$candidate_session_id"
            fallback_session_service="$candidate_session_service"
            fallback_session_seat="$candidate_session_seat"
        fi
        if [[ -n "$manager_display" && \
              "$candidate_display" == "$manager_display" ]]; then
            select_desktop_candidate \
                "$candidate_bus" "$candidate_display" \
                "$candidate_wayland" "$candidate_session_type" \
                "$candidate_xauthority" "$candidate_session_id" \
                "$candidate_session_service" "$candidate_session_seat"
            return 0
        fi
    done < <(/usr/bin/pgrep -u "$UID" -x gnome-shell | /usr/bin/sort -nr)

    if [[ -n "$fallback_bus" ]]; then
        select_desktop_candidate \
            "$fallback_bus" "$fallback_display" "$fallback_wayland" \
            "$fallback_session_type" "$fallback_xauthority" \
            "$fallback_session_id" "$fallback_session_service" \
            "$fallback_session_seat"
        return 0
    fi
    return 1
}

start_desktop_relay() {
    local -a desktop_environment
    local desktop_vnc_log
    local native_openssl_modules
    local selected_xauthority
    local selected_desktop

    if ! discover_desktop_session; then
        log "Waiting for logged-in GNOME desktop target '$desktop_target'."
        until discover_desktop_session; do
            sleep 5
        done
    fi

    selected_desktop="${desktop_display:-$desktop_wayland}"
    log "Desktop target '$desktop_target' selected ${desktop_session_service:-unknown} session ${desktop_session_id:-unknown} on ${selected_desktop:-unknown}."

    if [[ "$desktop_relay" == vnc ]]; then
        if [[ "$desktop_session_type" != x11 || -z "$desktop_display" ]]; then
            log "The VNC desktop relay requires an X11/XRDP target; selected ${desktop_session_type:-unknown}."
            return 1
        fi
        selected_xauthority="$desktop_xauthority"
        if [[ -z "$selected_xauthority" && -f "$HOME/.Xauthority" ]]; then
            selected_xauthority="$HOME/.Xauthority"
        fi
        if ! /usr/bin/env DISPLAY="$desktop_display" \
            XAUTHORITY="$selected_xauthority" \
            /usr/bin/xdpyinfo >/dev/null 2>&1; then
            log 'The VNC relay cannot access the selected X11 desktop.'
            return 1
        fi

        desktop_vnc_log="$state_dir/desktop-x11vnc.log"
        : >"$desktop_vnc_log"
        /usr/bin/env \
            DISPLAY="$desktop_display" \
            XAUTHORITY="$selected_xauthority" \
            /usr/bin/x11vnc \
            -norc \
            -display "$desktop_display" \
            -auth "$selected_xauthority" \
            -localhost \
            -no6 \
            -nopw \
            -forever \
            -shared \
            -repeat \
            -nobell \
            -modtweak \
            -xkb \
            -add_keysyms \
            -seldir recv \
            -autoport 5922 \
            >>"$desktop_vnc_log" 2>&1 &
        desktop_x11vnc_pid=$!

        for _ in {1..150}; do
            if ! kill -0 "$desktop_x11vnc_pid" >/dev/null 2>&1; then
                log 'The localhost VNC desktop relay exited during startup.'
                return 1
            fi
            desktop_vnc_port="$(
                /usr/bin/sed -n 's/^PORT=\([0-9][0-9]*\)$/\1/p' \
                    "$desktop_vnc_log" | /usr/bin/tail -n 1
            )"
            if [[ "$desktop_vnc_port" =~ ^[0-9]+$ ]] &&
               /usr/bin/ss -H -ltnp "sport = :$desktop_vnc_port" \
                   2>/dev/null | /usr/bin/grep -q \
                   "pid=$desktop_x11vnc_pid,"; then
                log "Local VNC is relaying X11 $desktop_display on 127.0.0.1:$desktop_vnc_port."
                return 0
            fi
            sleep 0.1
        done

        log 'The localhost VNC desktop relay did not become ready.'
        return 1
    fi

    native_openssl_modules="$(
        /usr/bin/openssl version -m | /usr/bin/sed -n \
            's/^MODULESDIR: "\(.*\)"$/\1/p'
    )"
    if [[ -z "$native_openssl_modules" ||
          ! -d "$native_openssl_modules" ]]; then
        log 'Could not discover the native OpenSSL provider directory.'
        return 1
    fi

    desktop_environment=(
        "DBUS_SESSION_BUS_ADDRESS=$desktop_bus"
        "DISPLAY=$desktop_display"
        "LD_LIBRARY_PATH=$libei_dir"
        "OPENSSL_CONF=/etc/ssl/openssl.cnf"
        "OPENSSL_MODULES=$native_openssl_modules"
    )
    if [[ -n "$desktop_wayland" ]]; then
        desktop_environment+=("WAYLAND_DISPLAY=$desktop_wayland")
    fi
    if [[ -n "$desktop_session_type" ]]; then
        desktop_environment+=("XDG_SESSION_TYPE=$desktop_session_type")
    fi

    # XRDP starts GNOME on a private session bus. The regular user unit runs
    # on /run/user/$UID/bus and cannot see that shell, so launch GRD on the
    # bus belonging to the desktop that is actually being shared.
    if "${systemctl_user[@]}" is-active --quiet \
        gnome-remote-desktop.service; then
        grd_user_service_was_active=true
    fi
    "${systemctl_user[@]}" stop gnome-remote-desktop.service \
        >/dev/null 2>&1 || true
    /usr/bin/env "${desktop_environment[@]}" \
        /usr/libexec/gnome-remote-desktop-daemon --rdp-port "$rdp_port" \
        >>"$state_dir/gnome-remote-desktop.log" 2>&1 &
    grd_pid=$!

    for _ in {1..150}; do
        if ! kill -0 "$grd_pid" >/dev/null 2>&1; then
            log 'GNOME Desktop Sharing exited during startup.'
            return 1
        fi
        if /usr/bin/ss -H -ltnp "sport = :$rdp_port" 2>/dev/null | \
            /usr/bin/grep -q "pid=$grd_pid,"; then
            log "GNOME Desktop Sharing is relaying $desktop_session_type ${desktop_display:-$desktop_wayland}."
            return 0
        fi
        sleep 0.1
    done

    log "GNOME Desktop Sharing did not open 127.0.0.1:$rdp_port."
    return 1
}

start_x11_input_helper() {
    local helper_display
    local helper_kind
    local -a injection_options=()
    local selected_xauthority

    active_keyboard_route="rdp"
    x11_input_semantic_only=false
    if [[ ! -x "$x11_input_helper" ]]; then
        log 'The optional direct X11 keyboard helper is missing; retaining the RDP input route.'
        return 0
    fi

    helper_display="$desktop_display"
    selected_xauthority="$desktop_xauthority"
    if [[ -z "$selected_xauthority" && -f "$HOME/.Xauthority" ]]; then
        selected_xauthority="$HOME/.Xauthority"
    fi
    if [[ "$keyboard_route" != rdp &&
          "$desktop_session_type" == x11 &&
          -n "$helper_display" ]]; then
        helper_kind=direct
    elif [[ "$desktop_relay" == rdp &&
            "$phone_text_mode" != keys &&
            -n "$helper_display" &&
            -r "$xauth_file" ]]; then
        helper_kind=semantic-relay
        x11_input_semantic_only=true
        injection_options=(
            --inject-display "$DISPLAY"
            --inject-xauthority "$xauth_file"
        )
    else
        if [[ "$keyboard_route" != rdp ]]; then
            log "Direct X11 keyboard input is unavailable for the selected ${desktop_session_type:-unknown} desktop; retaining the RDP input route."
        fi
        return 0
    fi
    if ! /usr/bin/env DISPLAY="$helper_display" \
        XAUTHORITY="$selected_xauthority" \
        /usr/bin/xdpyinfo >/dev/null 2>&1; then
        log 'The target desktop clipboard authorization could not be verified; retaining the RDP input route.'
        x11_input_semantic_only=false
        return 0
    fi

    rm -f "$x11_input_ready_file"
    x11_input_token="$(/usr/bin/openssl rand -hex 32)"
    /usr/bin/env \
        DISPLAY="$helper_display" \
        XAUTHORITY="$selected_xauthority" \
        UURB_X11_INPUT_TOKEN="$x11_input_token" \
        "$x11_input_helper" \
        --ready-file "$x11_input_ready_file" \
        --min-hold-ms "$physical_key_delay_ms" \
        "${injection_options[@]}" \
        >>"$state_dir/x11-input.log" 2>&1 &
    x11_input_pid=$!

    for _ in {1..50}; do
        if [[ -s "$x11_input_ready_file" ]] && \
           kill -0 "$x11_input_pid" >/dev/null 2>&1; then
            read -r x11_input_port <"$x11_input_ready_file"
            if [[ "$x11_input_port" =~ ^[1-9][0-9]{0,4}$ ]] && \
               ((x11_input_port <= 65535)); then
                if [[ "$helper_kind" == direct ]]; then
                    active_keyboard_route="x11"
                    log "Physical keyboard input uses direct X11 injection on $helper_display (minimum hold ${physical_key_delay_ms} ms)."
                else
                    log "Semantic phone text owns the physical clipboard on $helper_display and pastes through the private RDP relay."
                fi
                return 0
            fi
        fi
        if ! kill -0 "$x11_input_pid" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done

    log 'The direct X11 keyboard helper did not become ready; retaining the RDP input route.'
    kill "$x11_input_pid" >/dev/null 2>&1 || true
    for _ in {1..10}; do
        kill -0 "$x11_input_pid" >/dev/null 2>&1 || break
        sleep 0.1
    done
    if kill -0 "$x11_input_pid" >/dev/null 2>&1; then
        kill -KILL "$x11_input_pid" >/dev/null 2>&1 || true
    fi
    x11_input_pid=""
    x11_input_port=""
    x11_input_token=""
    x11_input_semantic_only=false
    rm -f "$x11_input_ready_file"
}

start_terminal_bridge() {
    local config_temporary

    if [[ ! -x "$terminal_bridge_helper" ||
          ! -f "$terminal_proxy_compat" ||
          ! -f "$terminal_proxy_exe" ]] ||
       ! /usr/bin/cmp -s "$terminal_proxy_compat" "$terminal_proxy_exe"; then
        log 'The native Ubuntu terminal compatibility bridge is missing or inconsistent.'
        return 1
    fi
    config_temporary="${terminal_config_file}.$$.tmp"
    rm -f \
        "$terminal_ready_file" \
        "$terminal_config_file" \
        "$config_temporary"
    terminal_bridge_token="$(/usr/bin/openssl rand -hex 32)"
    /usr/bin/env \
        UURB_TERMINAL_BRIDGE_TOKEN="$terminal_bridge_token" \
        "$terminal_bridge_helper" --ready-file "$terminal_ready_file" \
        >>"$state_dir/terminal-bridge.log" 2>&1 &
    terminal_bridge_pid=$!

    for _ in {1..50}; do
        if [[ -s "$terminal_ready_file" ]] && \
           kill -0 "$terminal_bridge_pid" >/dev/null 2>&1; then
            read -r terminal_bridge_port <"$terminal_ready_file"
            if [[ "$terminal_bridge_port" =~ ^[1-9][0-9]{0,4}$ ]] && \
               ((terminal_bridge_port <= 65535)); then
                if ! (
                    umask 077
                    printf 'version=1\nport=%s\ntoken=%s\n' \
                        "$terminal_bridge_port" \
                        "$terminal_bridge_token" >"$config_temporary"
                ) || ! chmod 600 "$config_temporary" ||
                   ! mv -f -- "$config_temporary" "$terminal_config_file"; then
                    log 'The UU terminal runtime handoff could not be written.'
                    break
                fi
                export UURB_TERMINAL_BRIDGE_PORT="$terminal_bridge_port"
                export UURB_TERMINAL_BRIDGE_TOKEN="$terminal_bridge_token"
                log "UU terminal requests use the authenticated native Ubuntu PTY bridge on loopback port $terminal_bridge_port."
                return 0
            fi
        fi
        if ! kill -0 "$terminal_bridge_pid" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done

    log 'The native Ubuntu terminal bridge did not become ready.'
    kill "$terminal_bridge_pid" >/dev/null 2>&1 || true
    terminal_bridge_pid=""
    terminal_bridge_port=""
    terminal_bridge_token=""
    rm -f \
        "$terminal_ready_file" \
        "$terminal_config_file" \
        "$config_temporary"
    return 1
}

mkdir -p \
    "$state_dir" \
    "$runtime_dir" \
    "$WINEPREFIX/drive_c/users/$bridge_user/Temp"
chmod 700 "$runtime_dir"

if [[ ! -x "$wine_stop_bin" ]]; then
    log 'The prefix-scoped Wine cleanup helper is missing.'
    exit 1
fi

if ! start_desktop_relay; then
    exit 1
fi
if ! align_resolution_at_startup; then
    exit 1
fi
log "Using private display $DISPLAY at $resolution and RDP port $rdp_port."
if [[ "$cursor_guard_setting" == on ]]; then
    resolve_cursor_size
fi
if ! start_terminal_bridge; then
    exit 1
fi

touch "$xauth_file"
chmod 600 "$xauth_file"
/usr/bin/xauth -f "$xauth_file" add "$DISPLAY" . "$(/usr/bin/mcookie)"
export XAUTHORITY="$xauth_file"

/usr/bin/Xvfb "$DISPLAY" \
    -screen 0 "${resolution}x24" \
    -dpi 96 \
    -nolisten tcp \
    -noreset \
    -auth "$xauth_file" \
    >>"$state_dir/xvfb.log" 2>&1 &
xvfb_pid=$!

x_ready=false
for _ in {1..100}; do
    if /usr/bin/xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
        x_ready=true
        break
    fi
    sleep 0.1
done

if [[ "$x_ready" != true ]]; then
    log 'The private X11 display did not become ready.'
    exit 1
fi
private_display_tmp="$private_display_file.$$"
printf '%s\n' "$DISPLAY" >"$private_display_tmp"
chmod 0600 "$private_display_tmp"
mv "$private_display_tmp" "$private_display_file"

/usr/bin/openbox >>"$state_dir/openbox.log" 2>&1 &
openbox_pid=$!
start_x11_input_helper

if [[ "$desktop_relay" == rdp && ! -f "$freerdp_exe" ]]; then
    log 'The Windows FreeRDP client is missing from the Wine prefix.'
    exit 1
fi
if [[ "$desktop_relay" == vnc && ! -x /usr/bin/vncviewer ]]; then
    log 'The native VNC viewer is missing.'
    exit 1
fi

if [[ ! -f "$input_bridge_dll" || ! -f "$input_broker_exe" ||
      ! -f "$input_injector_exe" || ! -f "$service_control_exe" ||
      ! -x "$terminal_bridge_helper" ||
      ! -f "$terminal_proxy_compat" ||
      ! -f "$terminal_proxy_exe" ]] ||
   ! /usr/bin/cmp -s "$terminal_proxy_compat" "$terminal_proxy_exe"; then
    log 'The UU input or terminal compatibility bridge is missing from the Wine prefix.'
    exit 1
fi
if [[ "$cursor_guard_setting" == on && ! -f "$cursor_guard_dll" ]]; then
    log 'The optional UU cursor guard is missing from the Wine prefix.'
    exit 1
fi

select_network_interface
wine_host_environment=(/usr/bin/env)
if [[ -n "$active_network_interface" ]]; then
    if [[ -f "$network_filter" ]]; then
        wine_host_environment+=(
            "UURB_NETWORK_INTERFACE=$active_network_interface"
            "LD_PRELOAD=$network_filter"
        )
    else
        log 'The optional UU network filter is missing; preserving the unfiltered adapter list.'
        active_network_interface=""
    fi
fi

if [[ "$desktop_relay" == rdp ]]; then
    password="$(
        /usr/bin/env DBUS_SESSION_BUS_ADDRESS="$desktop_bus" \
            /usr/bin/secret-tool lookup service uu-desktop-bridge \
            username "$bridge_user" || true
    )"
    if [[ -z "$password" ]]; then
        log 'The RDP bridge password is missing from the login keyring.'
        exit 1
    fi

    tls_cert="$(/usr/bin/gsettings get \
        org.gnome.desktop.remote-desktop.rdp tls-cert)"
    tls_cert="${tls_cert#\'}"
    tls_cert="${tls_cert%\'}"
    if [[ ! -f "$tls_cert" ]]; then
        log 'The configured GNOME RDP TLS certificate is missing.'
        exit 1
    fi
    tls_fingerprint="$(
        /usr/bin/openssl x509 -in "$tls_cert" -outform DER | \
            /usr/bin/sha256sum | /usr/bin/awk '{print $1}'
    )"
    cert_option="/cert:fingerprint:sha256:$tls_fingerprint"
fi

/usr/bin/timeout --kill-after=1s 5s \
    /usr/bin/env WINEPREFIX="$WINEPREFIX" \
    /opt/wine-stable/bin/wineserver -k >/dev/null 2>&1 || true
/usr/bin/timeout --kill-after=1s 5s \
    /usr/bin/env WINEPREFIX="$WINEPREFIX" \
    /opt/wine-stable/bin/wineserver -w >/dev/null 2>&1 || true

"${wine_host_environment[@]}" "$compat_dir/winlogon.exe" \
    >>"$state_dir/winlogon.log" 2>&1 &
winlogon_pid=$!

uu_ready=false
for _ in {1..120}; do
    if pgrep -u "$UID" -f 'GameViewerServer\.exe' >/dev/null && \
       pgrep -u "$UID" -f 'GameViewerHealthd' >/dev/null; then
        uu_ready=true
        break
    fi
    sleep 0.25
done

if [[ "$uu_ready" != true ]]; then
    log 'UU Remote background processes did not become ready.'
    exit 1
fi

broker_environment=(/usr/bin/env)
if [[ -n "$x11_input_port" ]]; then
    broker_environment+=(
        "UURB_X11_INPUT_PORT=$x11_input_port"
        "UURB_X11_INPUT_TOKEN=$x11_input_token"
    )
    if [[ "$x11_input_semantic_only" == true ]]; then
        broker_environment+=("UURB_X11_INPUT_SEMANTIC_ONLY=1")
    fi
fi
"${broker_environment[@]}" /opt/wine-stable/bin/wine "$input_broker_exe" \
    >>"$state_dir/input-broker.log" 2>&1 &
input_broker_pid=$!

sleep 0.2
if ! kill -0 "$input_broker_pid" >/dev/null 2>&1; then
    log 'The UU input broker exited during startup.'
    exit 1
fi

input_bridge_windows_path="$(
    /opt/wine-stable/bin/winepath -w "$input_bridge_dll"
)"
if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
    "$input_bridge_windows_path" \
    >>"$state_dir/input-injector.log" 2>&1; then
    log 'Could not inject the UU input compatibility bridge.'
    exit 1
fi
if [[ "$cursor_guard_setting" == on ]]; then
    cursor_guard_windows_path="$(
        /opt/wine-stable/bin/winepath -w "$cursor_guard_dll"
    )"
    rm -f "$cursor_reader_guard_log"
    if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
        "$cursor_guard_windows_path" GameViewerServer.exe \
        >>"$state_dir/cursor-reader-guard-injector.log" 2>&1; then
        log 'Could not inject the UU cursor reader guard.'
        exit 1
    fi
    cursor_reader_guard_ready=false
    for _ in {1..100}; do
        if grep -q 'UU cursor reader guard active' \
            "$cursor_reader_guard_log" 2>/dev/null; then
            cursor_reader_guard_ready=true
            break
        fi
        if grep -q 'UU cursor reader guard initialization failed' \
            "$cursor_reader_guard_log" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ "$cursor_reader_guard_ready" != true ]]; then
        log 'The UU cursor reader guard did not initialize.'
        exit 1
    fi
fi
server_pid="$(pgrep -o -u "$UID" -f 'GameViewerServer\.exe')"

relay_ready=false
if [[ "$desktop_relay" == rdp ]]; then
    freerdp_mouse_options=()
    if [[ "$cursor_guard_setting" == on ]]; then
        freerdp_mouse_options+=(/mouse:relative:off,grab:off)
    fi
    /opt/wine-stable/bin/wine "$freerdp_exe" \
        "/v:127.0.0.1:$rdp_port" \
        "/u:$bridge_user" \
        /from-stdin:force \
        "$cert_option" \
        /sspi-module:'C:\Program Files\FreeRDP\winpr-sspi-shim.dll' \
        /auth-pkg-list:'none,ntlm' \
        /network:auto \
        "/size:$resolution" \
        /bpp:32 \
        /gdi:sw \
        /audio-mode:2 \
        "${freerdp_mouse_options[@]}" \
        /prevent-session-lock:180 \
        /t:Ubuntu-Desktop-Relay \
        +f \
        -toggle-fullscreen \
        -decorations \
        -suppress-output \
        +clipboard \
        +auto-reconnect \
        /auto-reconnect-max-retries:0 \
        /log-level:WARN \
        <<<"$password" >>"$state_dir/freerdp.log" 2>&1 &
    freerdp_pid=$!
    unset password

    for _ in {1..300}; do
        if /usr/bin/xdotool search --name Ubuntu-Desktop-Relay \
            >/dev/null 2>&1; then
            relay_ready=true
            break
        fi
        # Wine's Unix launcher may exit after handing the Windows process to
        # wineserver. Its lifetime does not represent the client lifetime.
        sleep 0.1
    done
    if [[ "$relay_ready" != true ]]; then
        log 'FreeRDP did not create the Ubuntu desktop relay window.'
        exit 1
    fi

    if [[ "$cursor_guard_setting" == on ]]; then
        rm -f "$cursor_guard_log"
        if ! /opt/wine-stable/bin/wine "$input_injector_exe" \
            "$cursor_guard_windows_path" sdl-freerdp.exe \
            >>"$state_dir/cursor-guard-injector.log" 2>&1; then
            log 'Could not inject the FreeRDP cursor guard.'
            exit 1
        fi
        cursor_guard_ready=false
        for _ in {1..100}; do
            if grep -q 'UU relay cursor guard active' \
                "$cursor_guard_log" 2>/dev/null; then
                cursor_guard_ready=true
                break
            fi
            if grep -q 'UU cursor guard initialization failed' \
                "$cursor_guard_log" 2>/dev/null; then
                break
            fi
            sleep 0.05
        done
        if [[ "$cursor_guard_ready" != true ]]; then
            log 'The FreeRDP cursor guard did not initialize.'
            exit 1
        fi
    fi

    relay_window_id="$(
        /usr/bin/xdotool search --onlyvisible \
            --name '^Ubuntu-Desktop-Relay$' 2>/dev/null \
            | /usr/bin/tail -n 1
    )"
else
    desktop_vnc_display=$((desktop_vnc_port - 5900))
    /usr/bin/env \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/dev/null \
        /usr/bin/vncviewer \
        -AllowMainClose=1 \
        -LogToAddressBook=0 \
        -FullScreen=1 \
        -FullScreenHint=1 \
        -EnableToolbar=0 \
        -AcceptBell=0 \
        -AudioVolume=0 \
        -WarnUnencrypted=0 \
        -VerifyId=0 \
        -Shared=1 \
        -Scaling=Fit \
        -DynamicResolution=0 \
        -GrabKeyboard="$vnc_grab_keyboard_value" \
        -SendKeyEvents=1 \
        -SendPointerEvents=1 \
        -ClientCutText=1 \
        -ServerCutText=0 \
        -SendPrimary=0 \
        -SendInitialClipboard=0 \
        -ServerClipboardGraceTime=5000 \
        -MenuKey= \
        -UpdateScreenshot=0 \
        -ShowSplash=0 \
        -EnableAnalytics=0 \
        -ShareFiles=0 \
        -EnableRemotePrinting=0 \
        -ChangeServerDefaultPrinter=0 \
        "127.0.0.1:$desktop_vnc_display" \
        >>"$state_dir/vncviewer-relay.log" 2>&1 &
    vncviewer_pid=$!

    for _ in {1..300}; do
        relay_window_id="$(
            {
                /usr/bin/xdotool search --onlyvisible \
                    --pid "$vncviewer_pid" \
                    --name '^127\.0\.0\.1:.* - RealVNC Viewer$' \
                    2>/dev/null || true
            } | /usr/bin/tail -n 1
        )"
        if [[ -n "$relay_window_id" ]]; then
            relay_ready=true
            break
        fi
        if ! kill -0 "$vncviewer_pid" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
    if [[ "$relay_ready" != true ]]; then
        log 'The VNC viewer did not create the Ubuntu desktop relay window.'
        exit 1
    fi
fi

if [[ -z "$relay_window_id" ]]; then
    log 'Could not identify the Ubuntu desktop relay window.'
    exit 1
fi
/usr/bin/xdotool windowactivate --sync "$relay_window_id" \
    >/dev/null 2>&1 || true

bootstrap_account() {
    /opt/wine-stable/bin/wine "$service_control_exe" \
        GameViewerService 133 \
        >>"$state_dir/service-control.log" 2>&1 || true
    /opt/wine-stable/bin/wine start /unix "$uu_app_dir/GameViewer.exe" \
        >>"$state_dir/client-bootstrap.log" 2>&1 || true

    # Keep the layered Wine/Qt management window mapped. Minimizing it while
    # its top-level windows are still being replaced can raise BadWindow,
    # terminate the GUI IPC client, and make the server destroy its room.
    # The relay focus supervisor safely keeps this window behind the desktop.
    sleep 1
    /usr/bin/xdotool windowactivate --sync "$relay_window_id" \
        >/dev/null 2>&1 || true
}

# UU's GUI sends the account-login IPC message that makes the background
# server visible to other devices. Let it exit normally: forcibly closing it
# also asks the server to exit.
bootstrap_account

supervise_server() {
    local last_pid="$1"
    local candidate
    local candidate_relay_window_id
    local current_default_interface
    local active_window_id
    local focus_checks=0
    local grd_fd_count
    local health_checks=0
    local missing_checks=0
    local network_route_checks=0
    local current_desktop_resolution
    local pending_resolution=""
    local pending_resolution_checks=0
    local resolution_checks=0
    local resolution_grace_checks=240

    while true; do
        candidate="$(pgrep -o -u "$UID" -f 'GameViewerServer\.exe' || true)"
        if [[ -z "$candidate" ]]; then
            missing_checks=$((missing_checks + 1))
            if ((missing_checks >= 40)); then
                log 'UU server was absent for 10 seconds; restarting the bridge.'
                return 1
            fi
        else
            missing_checks=0
        fi
        if [[ -n "$candidate" && "$candidate" != "$last_pid" ]]; then
            sleep 0.25
            if /opt/wine-stable/bin/wine "$input_injector_exe" \
                "$input_bridge_windows_path" \
                >>"$state_dir/input-injector.log" 2>&1; then
                last_pid="$candidate"
                log "Re-injected UU server process $candidate."
                bootstrap_account
            else
                log "Could not re-inject UU server process $candidate."
                return 1
            fi
        fi
        focus_checks=$((focus_checks + 1))
        if ((focus_checks >= 4)); then
            focus_checks=0
            # RealVNC may replace its initial top-level window when it enters
            # full-screen mode. Refresh the ID before focusing so an obsolete
            # startup ID cannot leave UU's management window over the relay.
            if [[ "$desktop_relay" == vnc ]]; then
                candidate_relay_window_id="$(
                    {
                        /usr/bin/xdotool search --onlyvisible \
                            --pid "$vncviewer_pid" \
                            --name '^127\.0\.0\.1:.* - RealVNC Viewer$' \
                            2>/dev/null || true
                    } | /usr/bin/tail -n 1
                )"
                if [[ -n "$candidate_relay_window_id" ]]; then
                    relay_window_id="$candidate_relay_window_id"
                fi
            fi
            active_window_id="$(
                /usr/bin/xdotool getactivewindow 2>/dev/null || true
            )"
            if [[ ! -e "$console_focus_file" && \
                  -n "$active_window_id" && \
                  "$active_window_id" != "$relay_window_id" ]]; then
                /usr/bin/xdotool windowactivate "$relay_window_id" \
                    >/dev/null 2>&1 || true
            fi
        fi
        health_checks=$((health_checks + 1))
        if ((grd_fd_restart_threshold > 0 && health_checks >= 40)); then
            health_checks=0
            if [[ -d "/proc/$grd_pid/fd" ]]; then
                grd_fd_count="$(
                    /usr/bin/find "/proc/$grd_pid/fd" -maxdepth 1 \
                        -type l -printf '.\n' 2>/dev/null | /usr/bin/wc -l
                )"
                if ((grd_fd_count >= grd_fd_restart_threshold)); then
                    log "GNOME Remote Desktop reached $grd_fd_count file descriptors; restarting the relay before exhaustion."
                    return 1
                fi
            fi
        fi
        if [[ "$network_interface" == default && \
              -n "$active_network_interface" ]]; then
            network_route_checks=$((network_route_checks + 1))
            if ((network_route_checks >= 40)); then
                network_route_checks=0
                current_default_interface="$(default_network_interface)"
                if [[ -n "$current_default_interface" && \
                      "$current_default_interface" != \
                      "$active_network_interface" ]]; then
                    log "Default network interface changed from $active_network_interface to $current_default_interface; restarting UU on the preferred route."
                    return 1
                fi
            fi
        fi
        if [[ "$follow_desktop_resolution" == on &&
              "$desktop_relay" == vnc ]]; then
            if ((resolution_grace_checks > 0)); then
                resolution_grace_checks=$((resolution_grace_checks - 1))
            else
                resolution_checks=$((resolution_checks + 1))
                if ((resolution_checks >= 20)); then
                    resolution_checks=0
                    current_desktop_resolution="$(desktop_geometry || true)"
                    if [[ -z "$current_desktop_resolution" ||
                          "$current_desktop_resolution" == "$resolution" ]]; then
                        pending_resolution=""
                        pending_resolution_checks=0
                    elif [[ "$current_desktop_resolution" == \
                            "$pending_resolution" ]]; then
                        pending_resolution_checks=$((
                            pending_resolution_checks + 1
                        ))
                    else
                        pending_resolution="$current_desktop_resolution"
                        pending_resolution_checks=1
                    fi
                    if ((pending_resolution_checks >= 3)); then
                        if ! persist_relay_resolution \
                            "$pending_resolution"; then
                            log 'Could not persist the stable desktop resolution; retaining the current canvas.'
                            pending_resolution=""
                            pending_resolution_checks=0
                        else
                            log "Desktop resolution remained stable at $pending_resolution; restarting only the UU bridge to align its canvas."
                            "${systemctl_user[@]}" --no-block restart \
                                "$service_name" >/dev/null 2>&1 || return 1
                            sleep 10
                            return 1
                        fi
                    fi
                fi
            fi
        fi
        sleep 0.25
    done
}

supervise_server "$server_pid" &
server_supervisor_pid=$!

log "UU Remote and the $desktop_relay desktop relay share DISPLAY=$DISPLAY; physical keyboard route=$active_keyboard_route; semantic phone text helper=$([[ -n "$x11_input_port" ]] && printf active || printf unavailable)."

set +e
critical_pids=(
    "$xvfb_pid"
    "$openbox_pid"
    "$winlogon_pid"
    "$input_broker_pid"
    "$server_supervisor_pid"
)
for optional_pid in \
    "$grd_pid" \
    "$freerdp_pid" \
    "$desktop_x11vnc_pid" \
    "$vncviewer_pid" \
    "$x11_input_pid" \
    "$terminal_bridge_pid"; do
    if [[ -n "$optional_pid" ]]; then
        critical_pids+=("$optional_pid")
    fi
done
wait -n "${critical_pids[@]}"
set -e
log 'A bridge process exited; systemd will restart the complete relay.'
exit 1
